# ── LLM API — set ONE of these (checked in priority order) ──────────────────

# Anthropic Claude (recommended — used if ANTHROPIC_API_KEY is set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Pipeshift — long-context models (Kimi K2, Qwen, etc.)
# Get key at pipeshift.ai
PIPESHIFT_API_KEY=
PIPESHIFT_BASE_URL=https://api.pipeshift.com/api/v0/chat/completions
PIPESHIFT_MODEL=moonshotai/Kimi-K2.6

# OpenAI (fallback — used only if neither Anthropic nor Pipeshift keys are set)
OPENAI_API_KEY=

# ── Memory — HydraDB ────────────────────────────────────────────────────────
# Leave empty to use local JSON file (server/data/memory.json)
HYDRADB_API_KEY=
HYDRADB_BASE_URL=https://api.hydradb.com
HYDRADB_PROJECT_ID=corgi

# ── Personal Context — Thine ─────────────────────────────────────────────────
# Leave empty to use mock data
THINE_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
