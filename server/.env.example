# Model inference — Pipeshift (long-context, 1M+ tokens)
# Get key at pipeshift.ai
PIPESHIFT_API_KEY=
PIPESHIFT_BASE_URL=https://api.pipeshift.ai/v1
PIPESHIFT_MODEL=kimi-k2-0711-preview

# Fallback: OpenAI (used when PIPESHIFT_API_KEY is not set)
OPENAI_API_KEY=

# Memory — HydraDB
# Get key at hydradb.io
HYDRADB_API_KEY=

# Personal context — Thine
# Get key at thine.ai
THINE_API_KEY=

PORT=3001
